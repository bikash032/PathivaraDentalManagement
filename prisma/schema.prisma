// Pathivara Dental Clinic — Admin Management System
// Schema follows docs/DATABASE.md. Do not edit generated migrations directly;
// change this file and run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  key         String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdPatients     Patient[]           @relation("PatientCreatedBy")
  doctorAppointments  Appointment[]       @relation("AppointmentDoctor")
  createdAppointments Appointment[]       @relation("AppointmentCreatedBy")
  doctorVisits        Visit[]             @relation("VisitDoctor")
  createdVisits       Visit[]             @relation("VisitCreatedBy")
  createdInvoices     Invoice[]           @relation("InvoiceCreatedBy")
  receivedPayments    Payment[]           @relation("PaymentReceivedBy")
  treatedInvoiceItems InvoiceItem[]       @relation("InvoiceItemDoctor")
  createdAllocations  PaymentAllocation[] @relation("AllocationCreatedBy")
  reversedAllocations PaymentAllocation[] @relation("AllocationReversedBy")
  auditLogs           AuditLog[]
  sessions            Session[]

  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
}

model Patient {
  id                    String        @id @default(cuid())
  patientCode           String        @unique
  fullName              String
  phone                 String        @unique
  alternatePhone        String?
  address               String?
  dateOfBirth           DateTime?     @db.Date
  approxAge             Int?
  gender                Gender
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  allergies             String?
  status                PatientStatus @default(ACTIVE)
  notes                 String?
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  createdBy     User           @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  visits        Visit[]
  prescriptions Prescription[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([fullName])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  reason          String?
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       User          @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  visit        Visit?
  invoiceItems InvoiceItem[]

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Clinical records
// ---------------------------------------------------------------------------

model Visit {
  id                   String    @id @default(cuid())
  patientId            String
  appointmentId        String?   @unique
  doctorId             String
  visitDate            DateTime  @default(now())
  chiefComplaint       String
  examination          String?
  diagnosis            String?
  treatmentNotes       String?
  clinicalNotes        String?
  followUpInstructions String?
  nextAppointmentDate  DateTime? @db.Date
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor        User           @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id        String   @id @default(cuid())
  visitId   String
  patientId String
  notes     String?
  createdAt DateTime @default(now())

  visit   Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items   PrescriptionItem[]

  @@index([patientId])
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String?
  frequency      String?
  durationDays   Int?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// Treatments / billing
// ---------------------------------------------------------------------------

model Treatment {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  description  String?
  defaultPrice Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoiceItems InvoiceItem[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  payments Payment[]
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  patientId      String
  visitId        String?
  status         InvoiceStatus @default(UNPAID)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit       Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdBy   User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  // Cash received at this invoice's counter (historical link). What actually
  // settles the invoice is `allocations`; `paidAmount` is their active sum.
  payments    Payment[]
  allocations PaymentAllocation[]

  @@index([patientId])
  @@index([status])
}

/// Clinical progress of one billed treatment, independent of payment.
enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  treatmentId String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  // Treatment attribution: who performed this item, at which appointment, and
  // when it was completed. Treatment value, not cash and not payout.
  doctorId        String?
  appointmentId   String?
  // Tooth/teeth treated, as written by the clinic (e.g. "36", "11, 21").
  tooth           String?
  treatmentStatus TreatmentStatus @default(PLANNED)
  completedAt     DateTime?

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment   Treatment?   @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  doctor      User?        @relation("InvoiceItemDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([doctorId, completedAt])
  @@index([appointmentId])
}

/// RECEIPT = money in (amount > 0); REFUND = money out (amount < 0, linked to
/// the receipt it returns). Every non-voided row is real cash movement on
/// `paymentDate`, so collection = SUM(amount); applying credit never adds rows.
enum PaymentKind {
  RECEIPT
  REFUND
}

model Payment {
  id                String      @id @default(cuid())
  patientId         String
  kind              PaymentKind @default(RECEIPT)
  // Invoice the cash was taken against; null for an advance or a refund.
  invoiceId         String?
  refundOfPaymentId String?
  amount            Decimal     @db.Decimal(12, 2)
  paymentMethodId   String
  paymentDate       DateTime    @default(now())
  reference         String?
  notes             String?
  receivedById      String
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  receivedBy    User                @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  refundOf      Payment?            @relation("PaymentRefunds", fields: [refundOfPaymentId], references: [id], onDelete: Restrict)
  refunds       Payment[]           @relation("PaymentRefunds")
  allocations   PaymentAllocation[]

  @@index([invoiceId])
  @@index([patientId])
  @@index([paymentDate])
  @@index([refundOfPaymentId])
}

/// Applies part of a receipt to an invoice. Not a cash movement: applying an
/// advance never counts as collection. Reversals keep the row (reversedAt) so
/// the history stays auditable; only rows with reversedAt = null are active.
model PaymentAllocation {
  id            String    @id @default(cuid())
  paymentId     String
  invoiceId     String
  amount        Decimal   @db.Decimal(12, 2)
  createdById   String
  createdAt     DateTime  @default(now())
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("AllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy User?   @relation("AllocationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Audit / settings
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

model ClinicProfile {
  id                String   @id @default(cuid())
  clinicName        String
  address           String?
  phone             String?
  email             String?
  panNumber         String?
  logoUrl           String?
  receiptFooterNote String?
  updatedAt         DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
