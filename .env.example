# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Local dev default matches the database created during Phase 1 setup.
DATABASE_URL="postgresql://pathivara_app:CHANGE_ME@localhost:5432/pathivara_dental_dev?schema=public"

# Session/auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Base URL of the app (used for links in emails/receipts if needed)
APP_URL="http://localhost:3000"

# Clinic name used only when the seed first creates the clinic profile.
# Leave empty to use the official name in src/lib/clinic-branding.ts;
# afterwards the name and address are edited in Settings.
CLINIC_NAME=""

# Seeded once by `npx prisma db seed` if this user doesn't already exist.
# Change this password after your first login.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="CHANGE_ME"
