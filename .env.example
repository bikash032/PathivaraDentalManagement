# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Local dev default matches the database created during Phase 1 setup.
DATABASE_URL="postgresql://pathivara_app:CHANGE_ME@localhost:5432/pathivara_dental_dev?schema=public"

# Session/auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Base URL of the app (used for links in emails/receipts if needed)
APP_URL="http://localhost:3000"

# Clinic identity shown on receipts/reports (also editable later via Settings module)
CLINIC_NAME="Pathivara Dental Clinic"
